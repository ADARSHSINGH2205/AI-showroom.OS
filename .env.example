# Copy to .env locally. Never commit the real .env file.
ENVIRONMENT=production
SECRET_KEY=replace-with-a-cryptographically-random-64-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=ai-showroom-os
JWT_AUDIENCE=ai-showroom-os-api

SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=replace-with-a-strong-unique-owner-password

POSTGRES_USER=showroom
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://showroom:replace-with-a-strong-database-password@db:5432/ai_showroom_os

CORS_ORIGINS=["https://showroom.example.com"]
ALLOWED_HOSTS=["api.showroom.example.com"]
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
MAX_BILL_UPLOAD_BYTES=8388608

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OWNER_MOBILE_NUMBER=91xxxxxxxxxx
SMS_PROVIDER=whatsapp

VITE_API_URL=https://api.showroom.example.com/api/v1

APP_DOMAIN=showroom.example.com
API_DOMAIN=api.showroom.example.com
